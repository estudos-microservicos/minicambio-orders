{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Kafka": {
    "PaymentRequestsTopic": "minicambio.payment-requests",
    "PaymentResultsTopic": "minicambio.payment-results",
    "ConsumerGroupId": "orders-api"
  },
  "Orders": {
    "ReconciliationIntervalSeconds": 5
  }
}
